# Copy this file to .env and fill in values from:
# Firebase console → Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Display name shown in the browser tab and nav bar.
VITE_APP_NAME=MartAdmin

# Optional: fixed temporary password assigned to every admin-created account,
# instead of a random one per user. Leave blank to keep random (recommended —
# a shared fixed value is weaker since it's the same for every pending account).
VITE_TEMP_PASSWORD=

# Comma-separated list of branches/locations staff can choose from on their
# Account page, e.g. VITE_BRANCHES=Downtown,Uptown,Warehouse
VITE_BRANCHES=

# Optional: Google Custom Search API credentials, used to look up candidate
# product photos when a barcode resolves to a name but no product image
# (see services/photoSearchService.js). Leave blank to skip photo search —
# barcode name lookup still works without it.
# - API key: https://console.cloud.google.com/apis/credentials (enable the
#   "Custom Search API")
# - Search engine ID (cx): create one at
#   https://programmablesearchengine.google.com with "Image search" and
#   "Search the entire web" turned on
VITE_GOOGLE_CSE_API_KEY=
VITE_GOOGLE_CSE_CX=
