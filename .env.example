# Copy this file to .env and fill in values from:
# Firebase console → Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Display name shown in the browser tab and nav bar.
VITE_APP_NAME=MartAdmin

# Optional: fixed temporary password assigned to every admin-created account,
# instead of a random one per user. Leave blank to keep random (recommended —
# a shared fixed value is weaker since it's the same for every pending account).
VITE_TEMP_PASSWORD=

# Comma-separated list of branches/locations staff can choose from on their
# Account page, e.g. VITE_BRANCHES=Downtown,Uptown,Warehouse
VITE_BRANCHES=
