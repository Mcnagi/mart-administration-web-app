rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // "Active" means: has a profile doc, and it isn't disabled. Revoked users
    // (profile deleted or disabled) fail this even though their underlying
    // Firebase Auth credential still exists — see userService.revokeUser.
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().disabled == false;
    }

    function isAdmin() {
      return isActive() && myProfile().role == 'admin';
    }

    // Users can read their own profile (needed at login to check
    // disabled/role) even while disabled; any other active user can look up
    // a single profile by uid (used to show an item's uploader name); only
    // admins can list every profile. A signed-in user may also update their
    // own displayName and/or branch only — not role, disabled, or email —
    // via userService.updateOwnDisplayName / updateOwnBranch. The list of
    // valid branches is env-configured (VITE_BRANCHES) client-side only;
    // rules just check it's a non-empty string, since Firestore rules can't
    // see client env vars.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActive());
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'branch']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) || (
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 60
        )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['branch']) || (
          request.resource.data.branch is string &&
          request.resource.data.branch.size() > 0 &&
          request.resource.data.branch.size() <= 60
        ))
      );
      allow delete: if isAdmin();
    }

    // Shared inventory: any active (non-disabled) user can see and manage
    // every item — there's no per-user ownership restriction, matching the
    // "shared pantry list" use case.
    match /items/{itemId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isActive();
    }

    // Shared promo library: same access model as items — any active user
    // can see and manage every promo, since promos are shared marketing
    // material, not owned by whoever created them.
    match /promos/{promoId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isActive();
    }

    // Raw staging store for admin Excel imports (services/dataService.js),
    // decoupled from the curated `items` inventory above — admin-only in
    // both directions since nothing else in the app reads or writes it.
    match /data/{docId} {
      allow read, write: if isAdmin();
    }

    // Append-only audit trail of every items/users read+write and auth
    // event (see api/logsApi.js). Any signed-in user can write their own
    // entries — deliberately signedIn() rather than isActive(), so actions
    // taken while disabled/revoked (e.g. a blocked sign-in attempt) still
    // get logged — but the logged `uid` must match the caller, so no one
    // can log an action as someone else. Only admins can read the trail
    // back, and no entry can ever be edited or deleted once written.
    match /logs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }
  }
}
